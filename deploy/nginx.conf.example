# Replace the root and PHP socket for your server. Keep /cache and /php writable/available.
server {
    listen 80;
    server_name example.com;
    root /www/wwwroot/example.com;
    index index.html index.php;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    # Legacy PHP pages contain inline scripts; Vue pages use bundled scripts.
    # Add a route-specific nonce policy if tightening script-src further.
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: https:; media-src 'self' blob: https:; connect-src 'self' https:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:" always;

    location ~ (^|/)\. { deny all; }
    location ~ ^/php/(?:config|_env|_phase3_guard|_security)\.php$ { deny all; }
    location ^~ /cache/feedback/ { deny all; }
    location ^~ /cache/rate_limits/ { deny all; }
    location ^~ /admin/includes/ { deny all; }
    location ^~ /scripts/ { deny all; }
    location ~ ^/admin/(?:setup|check_db)\.php$ { deny all; }
    location ~* ^/upload/.*\.(?:php|phtml|phar|php[0-9]*)$ { deny all; }
    location ~* ^/ad-img/.*\.(?:php|phtml|phar|php[0-9]*)$ { deny all; }
    location ~ \.php$ {
        try_files $uri =404;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTP_AUTHORIZATION $http_authorization;
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
    }

    location /assets/ { try_files $uri =404; expires 1y; add_header Cache-Control "public, immutable"; }
    location / { try_files $uri $uri/ /index.html; }
}
