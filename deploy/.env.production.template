# PHP 私密运行配置。开发时复制为 deploy/.env；发布后复制为站点根目录 .env。
# 进程环境变量优先；模板不包含真实服务，示例地址不能直接搜索或播放音乐。
# 修改功能或音源配置后刷新页面，无需重新构建前端。
# 含空格、#、; 的值建议用双引号包裹。切勿提交真实密钥或生产配置。

# 功能开关严格接受 0 或 1。此模板为无需数据库/SMTP 的纯播放器示例。
# 代码缺省值：心动模式为 0，其余八项为 1；此处显式覆盖可选业务功能。
# 登录：启用后账户同步需数据库；关闭后保留本地收藏、歌单、历史及账户凭据。
XCLOUD_LOGIN_ENABLED=0
# 注册依赖登录；验证码邮件需 SMTP。登录关闭时注册自动关闭。
XCLOUD_REGISTER_ENABLED=0
# 心动推荐依赖登录和数据库。首次准备用 rebuild_heart_mode.php --force，之后再开启。
XCLOUD_HEART_MODE_ENABLED=0
# 站内热榜独立于登录；生成缓存需数据库。与网易官方榜单开关无关。
XCLOUD_HOT_TOPLIST_ENABLED=0
# 反馈开关；反馈邮件、回复与日报需要 SMTP 及 PHPMailer。
XCLOUD_FEEDBACK_ENABLED=0
# 平台开关同时控制入口、API 和自动备用；关闭不删除存量本地歌曲。
# 网易官方榜单/歌手/歌单接口也遵守网易开关。至少保留一个已接入平台。
XCLOUD_SOURCE_NETEASE_ENABLED=1
XCLOUD_SOURCE_KUWO_ENABLED=1
XCLOUD_SOURCE_QQ_ENABLED=1
XCLOUD_SOURCE_KUGOU_ENABLED=1

# 统一音乐 API：编号 1..20，按编号为同一平台尝试备用服务。
# URL 必须指向兼容服务入口，不是平台官网。完整协议见 docs/MUSIC_API.md。
# FORMAT 默认为 local，可选 meting；其他协议需编写 PHP 查询及响应适配器。
# ENABLED 默认为 1，SOURCES 默认为四个平台；空 URL 的组会跳过。
XCLOUD_MUSIC_API_1_URL=https://music-api.example.com/api.php
XCLOUD_MUSIC_API_1_FORMAT=local
XCLOUD_MUSIC_API_1_ENABLED=1
XCLOUD_MUSIC_API_1_SOURCES=netease,kuwo,qq,kugou
# 可选第二组示例；启用前填写兼容地址和实际支持的平台。
XCLOUD_MUSIC_API_2_URL=https://backup-api.example.com/api.php
XCLOUD_MUSIC_API_2_FORMAT=meting
XCLOUD_MUSIC_API_2_ENABLED=0
XCLOUD_MUSIC_API_2_SOURCES=netease,kuwo,qq,kugou
# 如需更多备用组，复制并递增编号至 20。不得把不同平台的歌曲 ID 混用。

# 以下为可选业务配置；纯播放器模式无需创建数据库或填写 SMTP。
# 数据库：启用账户/站内热榜/心动/后台数据管理前先创建 utf8mb4 数据库和专用用户。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=xcloud_music
DB_USER=your_database_user
DB_PASS=your_database_password
# 首次统一初始化 php scripts/init-database.php 使用；已有管理员密码不被重置。
# 密码至少 12 位，模板占位值会被拒绝；无需手工导入 SQL。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-install
# 禁止普通 Web 请求自动修改数据库结构，使用统一初始化入口。
XCLOUD_AUTO_MIGRATE=0

# 邮件：当前使用 SMTPS（默认 465），授权码与发件地址须符合服务商要求。
# 使用其他加密方式需同步修改 PHPMailer 配置。
SMTP_HOST=smtp.example.com
SMTP_USERNAME=mailer@example.com
SMTP_PASSWORD=your_smtp_authorization_code
SMTP_PORT=465
SMTP_FROM_ADDRESS=mailer@example.com
SMTP_FROM_NAME="XCloud音乐"
# 反馈日报收件地址，与 php/send_feedback_digest.php 定时任务配合。
FEEDBACK_RECIPIENT_EMAIL=maintainer@example.com

# 本地头像存储无需云服务；账户上传需 GD/fileinfo，upload/avatars/ 需要可写。
# 可选 COS 模式：设为 cos，并填写密钥、地域、含 APPID 后缀的桶名与 CDN 前缀。
AVATAR_STORAGE=local
AVATAR_CDN_BASE_URL=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET=

# 保留认证保护；不要以关闭身份验证代替功能开关。
XCLOUD_PHASE3_AUTH=1
# 可选站点地址兼容配置。统一原生音频解析不要求填写本站地址。
XCLOUD_PUBLIC_ORIGIN=
# 下载代理允许的音频主机，逗号分隔，可使用 .example.com 域名后缀。
# 按实际媒体域名填写，不填写完整 URL 或宽泛通配符。
XCLOUD_DOWNLOAD_ALLOWED_HOSTS=audio.example.com
# 可选独立酷我 MV 示例服务前缀；统一 local/meting 音乐协议不提供 MV。
# 只启用搜索/播放/歌词/封面时无需配置此项，MV 接口仍需单独适配并验收。
KUWO_SOURCE_BASE=https://mv-api.example.com/music/kw
