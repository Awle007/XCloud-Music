# 前端配置：复制为根目录 .env，修改后重启开发服务；生产环境需重新构建。
# 所有 VITE_ 值会公开到浏览器，切勿填写数据库密码、SMTP 授权码或云存储密钥。
# 同源 PHP 接口前缀，通常保持 /php；开发时由 Vite 转发。
VITE_API_BASE_URL=/php
# 请求超时时间，单位毫秒。
VITE_API_TIMEOUT_MS=15000
# 音乐 API 与功能开关由 PHP 运行环境配置，参见 deploy/.env.production.template。
# 默认留空使用本地头像；启用远程头像存储时填写完整访问地址前缀。
VITE_AVATAR_CDN_BASE_URL=
VITE_GITHUB_REPOSITORY_URL=https://github.com/Awle007/XCloud-Music
# 公开榜单缓存目录，与 PHP 生成文件的访问路径保持一致。
VITE_TOPLIST_CACHE_BASE=/cache
# 可选广告图片建议使用 /ad-img/ 下的本地路径，跳转地址替换为自己的页面。
# 多图清单位于 public/ad-img/manifest.json；具体优先顺序见 AdSlot.vue。
# 桌面顶部横幅。
VITE_AD_DESKTOP_BANNER_IMAGE=
VITE_AD_DESKTOP_BANNER_URL=https://example.com
# 桌面侧栏。
VITE_AD_DESKTOP_SIDEBAR_IMAGE=
VITE_AD_DESKTOP_SIDEBAR_URL=https://example.com
# 移动端横幅。
VITE_AD_MOBILE_BANNER_IMAGE=
VITE_AD_MOBILE_BANNER_URL=https://example.com
